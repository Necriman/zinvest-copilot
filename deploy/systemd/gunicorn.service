[Unit]
Description=Zinvest Gunicorn (Django)
After=network.target
Wants=redis-server.service postgresql.service

[Service]
Type=notify
User=zinvest
Group=www-data                       # nginx (www-data) must reach the socket
WorkingDirectory=/opt/zinvest/backend
EnvironmentFile=/opt/zinvest/.env
# Creates /run/auth-app with the right ownership on each start (socket dir).
RuntimeDirectory=auth-app
RuntimeDirectoryMode=0750
# No GUNICORN_BIND in the env -> gunicorn.conf.py binds the unix socket default.
ExecStart=/opt/zinvest/backend/.venv/bin/gunicorn config.wsgi:application -c gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
